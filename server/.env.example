# E-Drift backend (Render) environment
PORT=8080
SITE_URL=https://your-vercel-app.vercel.app

# Shared secret — must match the Vercel app's INTERNAL_API_KEY
INTERNAL_API_KEY=generate-a-long-random-string

# Supabase (service role — server only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="E-Drift Trikes <orders@yourdomain.com>"
ORDERS_NOTIFICATION_EMAIL=you@yourdomain.com

# Stripe (webhook lives here)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
