# E-Drift backend (Render) environment
PORT=8080
SITE_URL=https://edrifttrikes.shop

# Shared secret — must match the Cloudflare app's INTERNAL_API_KEY
INTERNAL_API_KEY=generate-a-long-random-string

# Supabase (service role — server only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="E-Drift Trikes <no-reply@edrifttrikes.shop>"
ORDERS_NOTIFICATION_EMAIL=you@edrifttrikes.shop

# Stripe (webhook lives here)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal (webhook verification lives here — refunds, disputes, reconciliation).
# Same credentials as the Cloudflare app, plus the Webhook ID from the webhook
# you create in the PayPal Developer dashboard. See docs/DEPLOYMENT.md section 4b.
PAYPAL_ENV=sandbox                 # sandbox | live
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Fulfillment scheduler — advances paid orders through the delivery journey
# (day 3 shipped, day 25 arriving, day 28 ready for collection) and emails the
# customer. Standard 5-field cron; the work itself runs in the app at
# POST /api/cron/orders, so SITE_URL + INTERNAL_API_KEY above must be correct.
FULFILLMENT_CRON=0 * * * *
