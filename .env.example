# ---- App (Cloudflare / Next.js via OpenNext) ----
# In production these are set in the Cloudflare dashboard (Workers & Pages →
# your project → Settings → Variables). Locally, copy this file to .env.
# Full env matrix + Supabase auth URLs: docs/SUPABASE_SETUP.md
# Production value: https://edrifttrikes.shop  (must match Supabase Site URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (auth + database + storage) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Render backend (REQUIRED — Stripe/PayPal webhooks, contact, scheduler) ----
# Base URL of the deployed Render service (see /server) and the shared secret
# that must match the Render service's INTERNAL_API_KEY.
#
# INTERNAL_API_KEY also authenticates the two internal endpoints this app
# exposes: /api/internal/order-paid (Render calls it after verifying a payment)
# and /api/cron/orders (the fulfillment scheduler). Both fail closed if it is
# unset. See docs/FULFILLMENT.md.
RENDER_API_URL=https://edrift-backend.onrender.com
INTERNAL_API_KEY=generate-a-long-random-string

# ---- Stripe (optional) ----
# The app creates the checkout session with STRIPE_SECRET_KEY; Stripe then calls
# the webhook on RENDER (which needs STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET)
# to mark the order paid and email the receipt. So the Stripe secret goes in
# BOTH places. If unset, Stripe simply isn't offered at checkout.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---- PayPal (optional alternative to Stripe) ----
# The app creates AND captures PayPal orders itself (no Render webhook needed).
# Captures BOTH PayPal-balance payments and debit/credit CARDS (buyer needs no
# PayPal account). Uses a PayPal BUSINESS account + Live REST app credentials.
# IMPORTANT: card checkout only appears if "PayPal account optional" is turned
# ON in the Business account's Website Payment Preferences — see docs/DEPLOYMENT.md
# section 4b. Checkout shows Stripe and/or PayPal depending on which is set.
PAYPAL_ENV=sandbox                 # "sandbox" for testing, "live" for real payments
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret

# ---- PayPal inline card fields (optional; no redirect, no "create account") ----
# Set NEXT_PUBLIC_PAYPAL_CARD_FIELDS=1 to render PayPal's Advanced Card Fields
# directly on the checkout page instead of redirecting to PayPal. Requires
# "Advanced Credit and Debit Card Payments" enabled+approved on the PayPal
# Business account; if the account isn't eligible the fields hide and the
# redirect button is used. Test in sandbox first. See docs/PAYMENTS.md §5.
NEXT_PUBLIC_PAYPAL_CARD_FIELDS=0

# ---- Cloudflare Turnstile (optional bot protection on contact + newsletter) ----
# When both are set, the forms show a Turnstile widget and the server verifies
# it. When unset, the forms work normally (no protection). Get keys at
# Cloudflare dashboard → Turnstile → Add site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key   # build-time (client widget)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key           # server verification
