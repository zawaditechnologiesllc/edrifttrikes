# ---- Supabase (auth + database) ----
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key for privileged operations (NEVER expose to the client).
# Used by Route Handlers / server actions if you add admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Render (backend API) ----
# Base URL of the backend service deployed on Render.
NEXT_PUBLIC_API_BASE_URL=https://edrift-api.onrender.com
