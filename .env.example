# ---- App (Vercel / Next.js) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (auth + database + storage) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Render backend (REQUIRED — email, Stripe webhook, contact) ----
# Base URL of the deployed Render service (see /server) and the shared secret
# that must match the Render service's INTERNAL_API_KEY.
RENDER_API_URL=https://edrift-backend.onrender.com
INTERNAL_API_KEY=generate-a-long-random-string

# ---- Stripe (checkout sessions created here; webhook handled on Render) ----
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
